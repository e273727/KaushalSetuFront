# Your separately-deployed backend's origin (used by the tRPC client).
# Leave unset and add a Vercel rewrite proxying /api/* to your backend instead
# if you'd rather avoid CORS.
VITE_API_URL=

# Manus OAuth portal used by startLogin() in src/const.ts
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Optional Umami analytics, referenced in index.html
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
